# ==============================================================================
# VortexJudge Environment Configuration Example
# ==============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=production

# Backend Base URLs (Use for Frontend / Mobile integrations)
# Production Live Backend:
VITE_API_URL=https://vortexjudge.onrender.com
NEXT_PUBLIC_API_URL=https://vortexjudge.onrender.com
REACT_APP_API_URL=https://vortexjudge.onrender.com

# For local development with split frontend/backend:
# VITE_API_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:3000
# REACT_APP_API_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=vortex_judge_production_secret_key_change_in_prod

# Optional Polygon Synchronization (if integrating with Codeforces Polygon)
POLYGON_API_KEY=your_api_key_here
POLYGON_API_SECRET=your_api_secret_here
# POLYGON_DEFAULT_ACCESS=alice:WRITE,bob:READ
